# Build dirs, including the firmware crate's own workspace.
target/
# Ad-hoc sim output stays out of git; curated results in testresults/ are kept.
*.csv
!testresults/**/*.csv

tools/__pycache__/

# The panel's default profiler output — scratch runs, curate elsewhere to keep.
testresults/panel-profile/

# Cygwin/MSYS crash dumps from the bash tooling.
*.stackdump

# Vendor hardware PDFs: freely downloadable but not ours to redistribute.
# See hw/README.md for the download links.
hw/*.pdf

*.log
testresults/**/log.txt
